# Copy to a house file, e.g. config/houses/smith.env
# Then: ./scripts/bootstrap.sh smith
#
# Values are expanded into config.js via MagicMirror ${VAR} support
# (also written to ~/MagicMirror/config/config.env).

HOUSE_NAME=Example House
LAT=42.4710579
LON=-83.0133362
TIMEZONE=America/Detroit
UNITS=imperial
TIME_FORMAT=12
LANGUAGE=en

# Prayer calc
PRAYER_METHOD=ISNA
PRAYER_ASR=Hanafi

# Optional OpenWeather (only if you enable weather modules that need it)
OPENWEATHER_API_KEY=

# Optional calendar iCal URL
CALENDAR_URL=
